  "rulings_version": "frozen",
  "scope": {
    "does_not_show": [
      {
        "code": "NO_MODEL_QUALITY_CLAIM",
        "text": "A sign ruling is a verdict on the measurement, never on the models; a flip means 'this comparison is not supported by its own data', never 'the other model wins'."
      },
      {
        "code": "NO_PRIVILEGED_DRAW",
        "text": "No draw is the correct one; all k are equally legitimate executions of the declared configuration, and there is no true score behind them to prefer."
      },
      {
        "code": "NO_FACTOR_ATTRIBUTION",
        "text": "'Draw' is a bucket holding everything that varies between two identical calls; no seed / hardware / order / version decomposition is claimed."
      },
      {
        "code": "NO_DRIFT_ABSENCE_CLAIM",
        "text": "A drift PASS means the checks that could run found nothing; UNAVAILABLE is not PASS, and absence of evidence of drift is not evidence of its absence."
      },
      {
        "code": "STABLE_SUBSET_IS_A_VIEW",
        "text": "The stable-items-only ranking conditions on a selected subset enriched for easy items; it is one view, not a corrected or true ranking."
      },
      {
        "code": "UNSTABLE_ITEMS_NOT_DEFECTIVE",
        "text": "Instability is a joint property of item, model, serving stack, grader and protocol; an item unstable for one model and stable for another is not defective."
      },
      {
        "code": "NO_K1_CERTIFICATE",
        "text": "The spread and MDD are reported at the observed k; no sufficiency certificate is issued for k=1 or any other k, on any benchmark or provider."
      },
      {
        "code": "EXACT_MATCH_GRADING_ONLY",
        "text": "Validity is scoped to deterministic exact-match grading; nothing here says anything about judge-scored, rubric-scored or preference-scored tasks."
      },
      {
        "code": "CONSTANCY_IS_NOT_CORRECTNESS",
        "text": "Flakiness and TARa measure repeatability only; a constant-but-wrong verdict is invisible to this instrument."
      }
    ]
  },
